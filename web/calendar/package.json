{
  "name": "outlook-aligner-calendar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "fullcalendar": "7.1.0",
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}

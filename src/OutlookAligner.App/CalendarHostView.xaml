<UserControl
    x:Class="OutlookAligner.App.CalendarHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TodayButton" Click="OnTodayClicked" Content="Today" IsEnabled="False" />
            <Button
                x:Name="PreviousMonthButton"
                Grid.Column="1"
                AutomationProperties.Name="Previous month"
                Click="OnPreviousClicked"
                Content="&#xE72B;"
                FontFamily="Segoe Fluent Icons"
                IsEnabled="False"
                ToolTipService.ToolTip="Previous month" />
            <Button
                x:Name="NextMonthButton"
                Grid.Column="2"
                AutomationProperties.Name="Next month"
                Click="OnNextClicked"
                Content="&#xE72A;"
                FontFamily="Segoe Fluent Icons"
                IsEnabled="False"
                ToolTipService.ToolTip="Next month" />
            <TextBlock
                x:Name="MonthTitle"
                Grid.Column="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Month" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="460" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Grid MinHeight="420">
                <WebView2 x:Name="CalendarWebView" />
                <Border
                    x:Name="CalendarWebFallback"
                    Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Calendar view unavailable" />
                        <TextBlock
                            x:Name="CalendarWebFallbackMessage"
                            MaxWidth="560"
                            Text="The calendar surface could not be displayed. Refresh or open Diagnostics for details."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,4,8,12" Spacing="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Selected observation" />
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding SelectedEvent.Subject}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="Source" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedEvent.SourceSmtp}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Time" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.TimeDisplay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Location" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEvent.Location}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Recurrence" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEvent.RecurrenceDisplay}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock
            x:Name="EmptyMessage"
            Grid.Row="2"
            Opacity="0.75"
            Text="No calendar events were found in this range."
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</UserControl>

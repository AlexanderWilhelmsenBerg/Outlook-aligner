<Window
    x:Class="OutlookAligner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Outlook Aligner">

    <Grid x:Name="RootLayout" Loaded="OnRootLoaded">
        <NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Calendar" Tag="calendar" />
                <NavigationViewItem Content="Alignment" Tag="alignment" />
                <NavigationViewItem Content="Settings" Tag="settings" />
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics" />
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Grid Margin="20">
                    <Grid x:Name="CalendarPanel" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Calendar" />
                                <TextBlock Opacity="0.7" Text="Select a meeting. Outlook Aligner handles Outlook identities and account routing automatically." />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Text="Horizon" />
                                <NumberBox
                                    Width="92"
                                    Maximum="3650"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{Binding ScanDays, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Text="days" />
                                <Button Command="{Binding RefreshCommand}" Content="Refresh" />
                                <ProgressRing Width="24" Height="24" IsActive="{Binding IsBusy}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock Opacity="0.75" Text="{Binding Status}" TextWrapping="Wrap" />
                            <InfoBar
                                IsClosable="False"
                                IsOpen="{Binding HasNotice}"
                                Message="{Binding NoticeMessage}"
                                Severity="Warning"
                                Title="Outlook notice" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="360" />
                                <ColumnDefinition Width="3*" MinWidth="420" />
                            </Grid.ColumnDefinitions>

                            <ListView
                                ItemsSource="{Binding Events}"
                                SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,8" RowSpacing="3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Opacity="0.75" Text="{Binding TimeDisplay}" />
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                                <TextBlock Opacity="0.65" Text="{Binding AccountName}" />
                                                <TextBlock Opacity="0.65" Text="{Binding RecurrenceDisplay}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="14" Padding="0,4,8,12">
                                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding SelectedEvent.Subject}" TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock FontWeight="SemiBold" Text="Source" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedEvent.SourceSmtp}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Time" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.TimeDisplay}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Location" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEvent.Location}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Recurrence" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEvent.RecurrenceDisplay}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Forward" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ForwardCapability}" />
                                    </Grid>

                                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Test target account" />
                                    <ComboBox
                                        ItemsSource="{Binding TargetAccounts}"
                                        SelectedItem="{Binding SelectedTargetAccount, Mode=TwoWay}"
                                        DisplayMemberPath="DisplayName"
                                        PlaceholderText="Choose another Outlook account" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding ProbeForwardCommand}" Content="Check Forward" />
                                        <Button Command="{Binding PrepareForwardCommand}" Content="Prepare Forward (discard)" />
                                    </StackPanel>

                                    <TextBlock
                                        Opacity="0.7"
                                        Text="Prepare Forward re-checks Outlook capability, resolves the selected target, and discards the unsent native forward. This UI slice cannot send a meeting."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <Grid x:Name="AlignmentPanel" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Alignment" />
                                <TextBlock
                                    MaxWidth="850"
                                    Opacity="0.7"
                                    Text="Select a logical meeting to inspect copies, choose authority, and preview safe alignment actions. Recurring occurrences stay explicitly unresolved until recurrence identity is proven."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="Refresh Outlook" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock Opacity="0.8" Text="{Binding AlignmentSummary}" TextWrapping="Wrap" />
                            <InfoBar
                                IsClosable="False"
                                IsOpen="{Binding HasNotice}"
                                Message="{Binding NoticeMessage}"
                                Severity="Warning"
                                Title="Outlook notice" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="480" />
                                <ColumnDefinition Width="2*" MinWidth="360" />
                            </Grid.ColumnDefinitions>

                            <ListView
                                ItemsSource="{Binding AlignmentGroups}"
                                SelectedItem="{Binding SelectedAlignmentGroup, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,10" ColumnSpacing="14" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="145" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock FontWeight="SemiBold" Text="{Binding State}" />
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding TimeSummary}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Opacity="0.75" Text="{Binding AccountSummary}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Opacity="0.7" Text="{Binding Explanation}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12" Padding="0,4,8,12">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SelectedAlignmentGroup.Subject}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedAlignmentGroup.Explanation}" TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="10" RowSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="State" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedAlignmentGroup.State}" />
                                        <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Missing from" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAlignmentGroup.MissingSummary}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Observed copies" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas" Text="{Binding SelectedAlignmentGroup.MemberDetails}" TextWrapping="Wrap" />
                                    </Grid>

                                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Authority" />
                                    <ComboBox
                                        ItemsSource="{Binding AuthorityChoices}"
                                        SelectedItem="{Binding SelectedAuthority, Mode=TwoWay}"
                                        DisplayMemberPath="DisplayName"
                                        IsEnabled="{Binding SelectedAlignmentGroup.CanChooseAuthority}"
                                        PlaceholderText="Choose authoritative account" />
                                    <TextBlock Opacity="0.75" Text="{Binding AuthorityStatus}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Opacity="0.65"
                                        Text="Authority selection is session-only and does not modify Outlook."
                                        TextWrapping="Wrap" />

                                    <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Move Selected preview" />
                                    <TextBlock Opacity="0.8" Text="{Binding MovePreviewStatus}" TextWrapping="Wrap" />
                                    <TextBox
                                        IsReadOnly="True"
                                        AcceptsReturn="True"
                                        MinHeight="90"
                                        FontFamily="Consolas"
                                        Text="{Binding MovePreviewDetails}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Opacity="0.65"
                                        Text="Preview only. This Phase 3 slice has no Move write command. Only validated Outlook Aligner-managed copies can ever appear as MOVE candidates."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <Grid x:Name="SettingsPanel" Visibility="Collapsed" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Settings" />
                            <TextBlock
                                MaxWidth="820"
                                Opacity="0.7"
                                Text="Configure the read horizon and inspect which Classic Outlook accounts are available to Outlook Aligner. Persistence will be added with the local settings store; this slice keeps the value for the running app."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Future scan horizon" />
                            <NumberBox
                                Width="110"
                                Maximum="3650"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{Binding ScanDays, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" Text="days" />
                            <Button Command="{Binding RefreshCommand}" Content="Apply and refresh" />
                            <ProgressRing Width="24" Height="24" IsActive="{Binding IsBusy}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="8">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Classic Outlook accounts" />
                            <ListView ItemsSource="{Binding Accounts}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,10" RowSpacing="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                                                <TextBlock Opacity="0.75" Text="{Binding AccountType}" />
                                                <TextBlock Opacity="0.75" Text="{Binding CalendarStatus}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Opacity="0.75" Text="{Binding ErrorSummary}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Diagnostics" />
                            <TextBlock Opacity="0.7" Text="Raw Outlook identities, host output, and partial-failure details live here instead of in normal workflows." TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Selected calendar item" />
                            <TextBox
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                Text="{Binding SelectedEventDiagnostics}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Latest host diagnostics" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    Text="{Binding LastDiagnostics}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
